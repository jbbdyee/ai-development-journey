    {
      "name": "Has question?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.question }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        220,
        300
      ],
      "id": "0cafcebc-1ba4-546e-aa2e-22f24643ca5a"
    },
    {
      "name": "Reject empty",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"error\": \"question is required\" }",
        "options": {
          "responseCode": 400
        }
      },
      "position": [
        440,
        560
      ],
      "id": "f60c3d44-3793-50e4-89c1-96c15c0075b0"
    },
    {
      "name": "Search FAQ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "http://data-api:8800/faq",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $('Question webhook').first().json.body.question }}"
            }
          ]
        }
      },
      "position": [
        440,
        300
      ],
      "id": "7bf6486f-83e4-56c6-9052-ee94305aa025"
    },
    {
      "name": "Get ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "=http://data-api:8800/tickets/{{ (($('Question webhook').first().json.body.question.match(/T-?\\d{4}/i) || ['NONE'])[0]).toUpperCase().replace(/^T(\\d)/, 'T-$1') }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "requester",
              "value": "={{ $('Question webhook').first().json.body.user ?? '' }}"
            }
          ]
        }
      },
      "position": [
        660,
        300
      ],
      "id": "9f1e31b4-c9b1-5848-8bc7-4f9f5c5b905b"
    },
    {
      "name": "Answer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "=질문: {{ $('Question webhook').first().json.body.question }}\nFAQ: {{ JSON.stringify($('Search FAQ').first().json.results ?? []) }}\n접수 건: {{ JSON.stringify($('Get ticket').first().json) }}",
        "options": {
          "systemMessage": "You are the company IT help desk. Answer in Korean in at most 3 sentences, using only the FAQ entries and the ticket record given. Never invent steps, dates or names. For a ticket, say its status and note. If the data does not answer the question, say \"찾지 못했습니다\" and that a staff member will help. Use 합니다체.",
          "maxIterations": 1
        }
      },
      "position": [
        880,
        300
      ],
      "id": "28d25947-3225-58fb-adec-112be9f61a60"
    },
    {
      "name": "Answer model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4.1-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "openAiCourse0001",
          "name": "OpenAI (.env)"
        }
      },
      "position": [
        880,
        520
      ],
      "id": "008c5ad6-673c-5e09-ae15-bbcf04777148"
    },
    {
      "name": "Build result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const results = $('Search FAQ').first().json.results ?? [];\nconst result = { route: '자동 답변', answer: String($json.output ?? '').trim(), sources: results.map((r) => r.id) };\nreturn [{ json: result }];"
      },
      "position": [
        1100,
        300
      ],
      "id": "5eabccbd-9c75-59f6-ac72-9070ef5f3a89"
    },
    {
      "name": "Send result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "position": [
        1320,
        300
      ],
      "id": "95e15847-a230-567c-a1f5-827a415a52a4"
    }
